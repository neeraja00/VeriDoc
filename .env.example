# Environment Configuration for VeriDoc AI: Verified Document Intelligence

# LLM Configuration
# Supported providers: "gemini" (default), "openai", "anthropic", "mock"
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Stubs for pluggable providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding Configuration
# Supported: "sentence-transformers" (default local), "gemini", "mock"
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Vector Store Configuration
CHROMA_PERSIST_DIR=./data/chroma_db
COLLECTION_NAME=knowledge_assistant

# RAG Hyperparameters
DEFAULT_CHUNK_SIZE=800
DEFAULT_CHUNK_OVERLAP=150
DEFAULT_TOP_K=4
SIMILARITY_SCORE_THRESHOLD=0.35

# Server Configuration
HOST=0.0.0.0
PORT=8000
